<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.wealthview</groupId>
    <artifactId>wealthview-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>WealthView Parent</name>
    <description>
        Self-hosted, multi-tenant personal finance platform covering investment portfolio monitoring,
        rental property tracking, and tax-aware retirement projection modeling.
        Built on Java 25 / Spring Boot 4.1 / PostgreSQL 16.
    </description>
    <url>https://github.com/jakefearsd/wealthview</url>
    <inceptionYear>2024</inceptionYear>

    <licenses>
        <license>
            <name>Private / Personal Use</name>
            <distribution>manual</distribution>
            <comments>Not open-sourced. For personal and family use only.</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>jfear</id>
            <name>Jake Fear</name>
            <roles>
                <role>Architect</role>
                <role>Lead Developer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/jakefearsd/wealthview.git</connection>
        <developerConnection>scm:git:https://github.com/jakefearsd/wealthview.git</developerConnection>
        <url>https://github.com/jakefearsd/wealthview</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/jakefearsd/wealthview/issues</url>
    </issueManagement>

    <ciManagement>
        <system>GitHub Actions</system>
        <url>https://github.com/jakefearsd/wealthview/actions</url>
    </ciManagement>

    <modules>
        <module>wealthview-persistence</module>
        <module>wealthview-core</module>
        <module>wealthview-api</module>
        <module>wealthview-import</module>
        <module>wealthview-projection</module>
        <module>wealthview-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <jjwt.version>0.13.0</jjwt.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <ofx4j.version>1.39</ofx4j.version>
        <jsoup.version>1.23.1</jsoup.version>
        <caffeine.version>3.2.4</caffeine.version>
        <samstevens-totp.version>1.7.1</samstevens-totp.version>
        <guava.version>33.6.0-jre</guava.version>
        <jsonassert.version>1.5.3</jsonassert.version>
        <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>
        <!-- Spring Boot BOM overrides. These two artifacts are declared without a <version>
             in the module poms, so they normally resolve from spring-boot-dependencies.
             Redeclaring the BOM's own property name here overrides it globally (Boot's
             documented mechanism). Both are PATCH bumps ahead of the 4.1.0 BOM and both
             are exercised by the test suite, so the compatibility risk we take on from
             Boot is covered: postgresql by the @DataJpaTest/Testcontainers slices, and
             httpclient5 only by the wealthview-app HTTP ITs (it is test-scope there).
             Drop these back to BOM defaults once a Boot release catches up.
             Deliberately NOT overridden: opentelemetry (micrometer-tracing-bridge-otel is
             compiled against a BOM-pinned OTel API, and a mismatch shows up at prod runtime
             rather than in tests) and flyway (12 -> 13 is a major affecting every migration;
             it needs its own change validated against the full IT suite). -->
        <httpclient5.version>5.6.3</httpclient5.version>
        <postgresql.version>42.7.13</postgresql.version>
        <!-- Quality tool versions -->
        <spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
        <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
        <jacoco-plugin.version>0.8.15</jacoco-plugin.version>
        <pmd-plugin.version>3.28.0</pmd-plugin.version>
        <!-- Quality-tool CORE versions overridden to Java-25-capable releases.
             Plugin versions stay; only the analysis engine they embed is pinned.
             PMD and SpotBugs are untouched: maven-pmd-plugin 3.28.0 already bundles
             PMD core 7.17.0, and spotbugs-maven-plugin 4.10.2.0 already bundles
             SpotBugs core 4.10.2 - both already JDK-25-capable, so only Checkstyle
             core + PIT are bumped. (An explicit PMD core override was tried via a
             <dependencies> block on maven-pmd-plugin - the only way to pin it, since
             <pmdVersion> in <configuration> is not a real parameter and is silently
             ignored - but forcing PMD core 7.26.0 surfaced 4 new rule violations
             that 7.17.0 doesn't flag, so the override was reverted rather than
             fixing unrelated findings as a side effect of a build-tooling commit.) -->
        <checkstyle.core.version>13.9.0</checkstyle.core.version>
        <!-- Site tool versions -->
        <maven-site-plugin.version>4.0.0-M16</maven-site-plugin.version>
        <project-info-reports-plugin.version>3.9.0</project-info-reports-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-surefire-report-plugin.version>3.5.5</maven-surefire-report-plugin.version>
        <versions-maven-plugin.version>2.21.0</versions-maven-plugin.version>
        <!-- JaCoCo coverage gate thresholds (jacoco:check on the verify phase).
             Defaults are conservative; each gated module overrides these in its
             own <properties> block. LINE minimums track the CLAUDE.md targets;
             BRANCH floors are set just below the levels reached during the
             coverage-hardening pass so the gate locks in gains without flaking. -->
        <jacoco.line.minimum>0.00</jacoco.line.minimum>
        <jacoco.branch.minimum>0.00</jacoco.branch.minimum>
        <jacoco.check.skip>true</jacoco.check.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.wealthview</groupId>
                <artifactId>wealthview-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wealthview</groupId>
                <artifactId>wealthview-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wealthview</groupId>
                <artifactId>wealthview-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wealthview</groupId>
                <artifactId>wealthview-import</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wealthview</groupId>
                <artifactId>wealthview-projection</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>
            <dependency>
                <groupId>com.webcohesion.ofx4j</groupId>
                <artifactId>ofx4j</artifactId>
                <version>${ofx4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.samstevens.totp</groupId>
                <artifactId>totp</artifactId>
                <version>${samstevens-totp.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skyscreamer</groupId>
                <artifactId>jsonassert</artifactId>
                <version>${jsonassert.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
            <!-- Override the ancient guava 15.0 (2013) that zxing:javase (pulled by
                 the TOTP QR library) drags in transitively. 15.0 carries assorted
                 DoS/local-temp-file CVEs; pin a current release. zxing uses only a
                 small, stable slice of guava, so the bump is API-compatible. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-project-info-reports-plugin</artifactId>
                    <version>${project-info-reports-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-report-plugin</artifactId>
                    <version>${maven-surefire-report-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>versions-maven-plugin</artifactId>
                    <version>${versions-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Medium</threshold>
                        <failOnError>true</failOnError>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                    </configuration>
                    <executions>
                        <!-- Gate: fail the verify phase on any SpotBugs violation. -->
                        <execution>
                            <id>spotbugs-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${checkstyle-plugin.version}</version>
                    <!-- Pin the Checkstyle analysis core to a JDK-25-capable release,
                         independent of the plugin version. -->
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.core.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/wealthview_checks.xml</configLocation>
                        <consoleOutput>true</consoleOutput>
                        <failOnViolation>true</failOnViolation>
                        <failsOnError>true</failsOnError>
                        <violationSeverity>warning</violationSeverity>
                    </configuration>
                    <executions>
                        <!-- Gate: fail the verify phase on any Checkstyle violation. -->
                        <execution>
                            <id>checkstyle-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${pmd-plugin.version}</version>
                    <!-- PMD core is NOT pinned here: forcing PMD core 7.26.0 via a
                         <dependencies> override surfaced 4 new rule violations that
                         the plugin's bundled PMD core 7.17.0 doesn't flag, and 7.17.0
                         is already >= the 7.16.0 JDK-25-capable floor. See the
                         pmd-plugin.version property comment above for the full story. -->
                    <configuration>
                        <targetJdk>25</targetJdk>
                        <failOnViolation>true</failOnViolation>
                        <printFailingErrors>true</printFailingErrors>
                        <linkXRef>true</linkXRef>
                        <rulesets>
                            <ruleset>pmd-ruleset.xml</ruleset>
                        </rulesets>
                    </configuration>
                    <executions>
                        <!-- Gate: fail the verify phase on copy-paste duplication. -->
                        <execution>
                            <id>pmd-cpd-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>cpd-check</goal>
                            </goals>
                        </execution>
                        <!-- Gate: fail the verify phase on PMD rule violations (Task 24).
                             Complexity-rule thresholds in pmd-ruleset.xml are raised to just
                             above the post-Phase-3 measured peaks, locking in no-regression;
                             genuine outliers and false positives carry narrow @SuppressWarnings
                             with justifications in the source. failOnViolation=true is already
                             set in the pluginManagement <configuration> above. -->
                        <execution>
                            <id>pmd-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>1.25.8</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.pitest</groupId>
                            <artifactId>pitest-junit5-plugin</artifactId>
                            <version>1.2.3</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <targetClasses>
                            <param>com.wealthview.core.projection.*</param>
                            <param>com.wealthview.core.projection.tax.*</param>
                            <param>com.wealthview.projection.*</param>
                            <param>com.wealthview.core.account.*</param>
                            <param>com.wealthview.core.split.*</param>
                            <param>com.wealthview.core.property.*</param>
                            <param>com.wealthview.core.auth.*</param>
                        </targetClasses>
                        <targetTests>
                            <param>com.wealthview.core.projection.*</param>
                            <param>com.wealthview.core.projection.tax.*</param>
                            <param>com.wealthview.projection.*</param>
                            <param>com.wealthview.core.account.*</param>
                            <param>com.wealthview.core.split.*</param>
                            <param>com.wealthview.core.property.*</param>
                            <param>com.wealthview.core.auth.*</param>
                        </targetTests>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <!-- Gate: fail the verify phase when coverage drops below the
                             per-module floor. Reads the unit-test jacoco.exec produced
                             by prepare-agent. Skipped by default (jacoco.check.skip=true);
                             each gated module enables it and supplies its own thresholds
                             via the jacoco.line.minimum / jacoco.branch.minimum
                             properties. -->
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <skip>${jacoco.check.skip}</skip>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.line.minimum}</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.branch.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <!-- Quality gates: bound to the verify phase via executions in pluginManagement. -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <reporting>
        <plugins>

            <!-- ── Project Information ────────────────────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-project-info-reports-plugin</artifactId>
                <version>${project-info-reports-plugin.version}</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>index</report>
                            <report>summary</report>
                            <report>team</report>
                            <report>scm</report>
                            <report>ci-management</report>
                            <report>issue-management</report>
                            <report>dependency-info</report>
                            <report>dependencies</report>
                            <report>dependency-convergence</report>
                            <report>modules</report>
                            <report>plugins</report>
                            <report>plugin-management</report>
                            <report>licenses</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <!-- ── Test Results ───────────────────────────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>${maven-surefire-report-plugin.version}</version>
                <configuration>
                    <linkXRef>true</linkXRef>
                </configuration>
            </plugin>

            <!-- ── Javadoc: per-module + aggregate at parent ─────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <source>25</source>
                    <linksource>true</linksource>
                    <failOnError>false</failOnError>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                    <detectJavaApiLink>true</detectJavaApiLink>
                    <links>
                        <link>https://docs.spring.io/spring-framework/docs/current/javadoc-api/</link>
                        <link>https://docs.spring.io/spring-data/commons/docs/current/api/</link>
                    </links>
                    <groups>
                        <group>
                            <title>Persistence Layer</title>
                            <packages>com.wealthview.persistence.*</packages>
                        </group>
                        <group>
                            <title>Core / Business Logic</title>
                            <packages>com.wealthview.core.*</packages>
                        </group>
                        <group>
                            <title>REST API</title>
                            <packages>com.wealthview.api.*</packages>
                        </group>
                        <group>
                            <title>Import</title>
                            <packages>com.wealthview.importmodule.*</packages>
                        </group>
                        <group>
                            <title>Projection Engine</title>
                            <packages>com.wealthview.projection.*</packages>
                        </group>
                    </groups>
                </configuration>
                <reportSets>
                    <!-- Aggregate Javadoc at parent level only -->
                    <reportSet>
                        <id>aggregate</id>
                        <inherited>false</inherited>
                        <reports>
                            <report>aggregate</report>
                        </reports>
                    </reportSet>
                    <!-- Per-module Javadoc for child modules -->
                    <reportSet>
                        <id>default</id>
                        <reports>
                            <report>javadoc</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <!-- ── Code Coverage (JaCoCo) ─────────────────────────────────────── -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-plugin.version}</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>report</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <!-- ── Bug Detection (SpotBugs) ──────────────────────────────────── -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <failOnError>false</failOnError>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
            </plugin>

            <!-- ── Style Conformance (Checkstyle) ───────────────────────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle-plugin.version}</version>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/wealthview_checks.xml</configLocation>
                    <failsOnError>false</failsOnError>
                    <linkXRef>true</linkXRef>
                </configuration>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>checkstyle</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

            <!-- ── Code Quality + Copy-Paste Detection (PMD / CPD) ──────────── -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${pmd-plugin.version}</version>
                <configuration>
                    <targetJdk>25</targetJdk>
                    <linkXRef>true</linkXRef>
                    <failOnViolation>false</failOnViolation>
                    <rulesets>
                        <ruleset>pmd-ruleset.xml</ruleset>
                    </rulesets>
                </configuration>
            </plugin>

            <!-- ── Dependency Version Currency ──────────────────────────────── -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions-maven-plugin.version}</version>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>dependency-updates-report</report>
                            <report>plugin-updates-report</report>
                            <report>property-updates-report</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>

        </plugins>
    </reporting>

    <distributionManagement>
        <site>
            <id>local</id>
            <name>WealthView Site</name>
            <url>file://${maven.multiModuleProjectDirectory}/target/site-deploy</url>
        </site>
    </distributionManagement>

</project>
