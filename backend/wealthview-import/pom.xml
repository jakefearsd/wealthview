<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wealthview</groupId>
        <artifactId>wealthview-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>wealthview-import</artifactId>
    <name>WealthView Import</name>

    <properties>
        <!-- JaCoCo gate: CLAUDE.md line target 0.80; branch floor just below
             the measured 0.7372 reached in the coverage-hardening pass. -->
        <jacoco.check.skip>false</jacoco.check.skip>
        <jacoco.line.minimum>0.80</jacoco.line.minimum>
        <jacoco.branch.minimum>0.71</jacoco.branch.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.wealthview</groupId>
            <artifactId>wealthview-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
        </dependency>
        <dependency>
            <groupId>com.webcohesion.ofx4j</groupId>
            <artifactId>ofx4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>
        <!-- Jackson 2 compatibility bridge (Boot 4 stop-gap): YahooFinanceClient
             parses responses with com.fasterxml.jackson (Jackson 2). Removed when
             the Jackson 3 source migration lands. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>
    </dependencies>
</project>
