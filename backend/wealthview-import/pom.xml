<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wealthview</groupId>
        <artifactId>wealthview-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>wealthview-import</artifactId>
    <name>WealthView Import</name>

    <properties>
        <!-- JaCoCo gate: floors ratcheted to the levels measured in the Task 9 coverage pass
             (line 0.97+, branch 0.8413 measured); round down, never lower. -->
        <jacoco.check.skip>false</jacoco.check.skip>
        <jacoco.line.minimum>0.97</jacoco.line.minimum>
        <jacoco.branch.minimum>0.84</jacoco.branch.minimum>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.wealthview</groupId>
            <artifactId>wealthview-core</artifactId>
        </dependency>
        <!-- Jackson 3 is imported directly by this module's code. Declared explicitly: it
             used to arrive only transitively via flyway-core, which made it optional in 13.9.0.
             Version from the Boot BOM. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
        </dependency>
        <dependency>
            <groupId>com.webcohesion.ofx4j</groupId>
            <artifactId>ofx4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>
    </dependencies>
</project>
