<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wealthview</groupId>
        <artifactId>wealthview-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>wealthview-persistence</artifactId>
    <name>WealthView Persistence</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Boot 4 modularized the monolithic spring-boot-autoconfigure: the
             Flyway auto-configuration now lives in spring-boot-flyway, pulled by
             this starter. Depending on raw flyway-core alone (the Boot 3 setup)
             no longer wires migrations, so both the app and @DataJpaTest slices
             would skip them. flyway-database-postgresql stays explicit — the
             starter does not bring the PostgreSQL-specific extension. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Annotations only (no databind): TransactionType carries @JsonValue/@JsonCreator so
             the enum owns its wire format for every module that serialises it. Jackson 3 keeps
             annotations at the 2.x com.fasterxml.jackson.core coordinates (tools.jackson.core
             is the databind/core split), and the Boot BOM manages the version. This does NOT
             make persistence depend on a serialisation runtime. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- Boot 4 moved the @DataJpaTest slice (plus @AutoConfigureTestDatabase
             and TestEntityManager) out of spring-boot-starter-test into dedicated
             test-slice modules. This starter restores them for the repository
             integration tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
