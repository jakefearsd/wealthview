# direnv config: auto-loads .env when you `cd` into the repo, and clears it
# again when you leave. Keeps real secrets out of your shell rc files and out
# of `git status` (because .env is gitignored).
#
# One-time setup per developer:
#   1. Install direnv          (apt: `apt install direnv` / brew: `brew install direnv`)
#   2. Hook into your shell    (bash: `eval "$(direnv hook bash)"` in ~/.bashrc)
#   3. From this directory:    `direnv allow`
#
# Without direnv this file is inert; the project falls back to the dev
# sentinel values declared in application-dev.yml.

dotenv_if_exists .env
