# Database
DB_PASSWORD=CHANGE_ME

# JWT signing secret (min 32 characters)
JWT_SECRET=CHANGE_ME

# AES-256-GCM key for encrypting TOTP MFA secrets at rest.
# Generate with: openssl rand -base64 32
# Required in production. Do NOT reuse the dev sentinel.
MFA_ENCRYPTION_KEY=CHANGE_ME

# Finnhub API key for live stock prices (optional)
FINNHUB_API_KEY=

# Enable Zillow property valuation sync (optional, defaults to false)
ZILLOW_ENABLED=false

# Super admin password
SUPER_ADMIN_PASSWORD=CHANGE_ME

# Backup retention in days (optional, defaults to 14)
BACKUP_RETENTION_DAYS=14

# CORS origin — REQUIRED in production. Comma-separated list of https:// origins
# allowed to call the API (e.g. your Cloudflare Tunnel hostname). The prod profile's
# ProductionConfigValidator aborts startup if this is empty or not https://.
# See docs/deployment/cloudflared.md and docs/deployment/production-setup.md.
CORS_ORIGIN=

# Port the app listens on (optional, defaults to 80)
APP_PORT=80

# --- Production-only ---------------------------------------------------------
# Pin the app image version. Setting this also flips ./wv into "prod" mode
# (uses docker-compose.prod.yml). Leave unset for local dev.
#
# Production PULLS this image from the registry — it is published by CI on a v*
# tag, after the unit tests, quality gates and full integration suite pass. Set
# it to the release you want, then run `wv update`.
#
# Pin a real version. `latest` is published as a convenience pointer, but
# deploying it breaks `wv rollback`, which recovers by re-pinning the tag that
# was running before the update.
# WEALTHVIEW_VERSION=1.2.5

# Registry/repository holding the app image. Only set this to use a fork, a
# private mirror, or an air-gapped registry. The default is the upstream GHCR
# package, which is public — no `docker login` is needed to pull it. A private
# fork or mirror needs a `docker login ghcr.io` with a read:packages token on
# this host before `wv update` can pull.
# WEALTHVIEW_IMAGE=ghcr.io/jakefearsd/wealthview

# --- Backup encryption (optional, recommended for production) ----------------
# age public key (the recipient) used by `./wv backup --encrypt`.
# Generate one with: age-keygen -o /etc/wealthview/backup.key
#   then read out the line starting with "# public key:".
# BACKUP_ENCRYPTION_RECIPIENT=age1...

# Path to the matching age identity file used by `./wv restore` and
# `./wv verify` to decrypt .dump.age files. Must be readable only by the
# admin user (chmod 600).
# BACKUP_ENCRYPTION_KEY_FILE=/etc/wealthview/backup.key

# --- Off-host backup destination (optional) ----------------------------------
# When `./wv backup --remote` is invoked, the final backup file is also
# uploaded here. Best-effort: failures do not fail the backup. Examples:
#   s3://my-bucket/wealthview-backups/
#   user@offsite.example.com:/srv/backups/wealthview/
#   rsync://offsite.example.com/backups/wealthview/
# BACKUP_REMOTE_DEST=
