      "id": 3,
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"wealthview\", area=\"heap\"})",
          "legendFormat": "heap used",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{application=\"wealthview\", area=\"heap\"})",
          "legendFormat": "heap max",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "decbytes"}, "overrides": []}
